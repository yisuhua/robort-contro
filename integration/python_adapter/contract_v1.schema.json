{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/industrial_robot/contract_v1.schema.json",
  "title": "PROPOSED future disassembly-direction adapter request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "frame_id", "joint_positions_rad"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "frame_id": {"const": "base_link"},
    "joint_positions_rad": {
      "type": "array", "items": {"type": "number"}, "minItems": 6, "maxItems": 6
    },
    "target_pose": {
      "type": "object", "additionalProperties": false,
      "required": ["xyz_m", "xyzw"],
      "properties": {
        "xyz_m": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
        "xyzw": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}
      }
    }
  }
}
